{
  "family": "docuflow-task",
  "containerDefinitions": [
    {
      "name": "docuflow-api",
      "image": "819498957810.dkr.ecr.ap-northeast-1.amazonaws.com/nycu/docuflow:latest",
      "cpu": 0,
      "portMappings": [
        {
          "name": "docuflow-api-8000-tcp",
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "CLOUDFRONT_DOMAIN",
          "value": "https://ddfedtuc7b3xl.cloudfront.net"
        },
        {
          "name": "AWS_S3_BUCKET",
          "value": "nycu-docuflow"
        },
        {
          "name": "GOOGLE_CLIENT_ID",
          "value": "837988850696-2kfh7ev8710clm6353p020i2u7gvl3j7.apps.googleusercontent.com"
        },
        {
          "name": "CLOUDFRONT_KEY_PAIR_ID",
          "value": "K2BE9MO719NMM3"
        },
        {
          "name": "FRONTEND_URL",
          "value": "https://docuflow.gnsjhenjie.ninja"
        },
        {
          "name": "OTEL_EXPORTER_OTLP_ENDPOINT",
          "value": "http://localhost:4318"
        },
        {
          "name": "OTEL_EXPORTER_OTLP_PROTOCOL",
          "value": "http/protobuf"
        },
        { "name": "OTEL_SERVICE_NAME", "value": "docuflow-api" },
        {
          "name": "OTEL_RESOURCE_ATTRIBUTES",
          "value": "service.namespace=docuflow,deployment.environment=prod,aws.region=ap-northeast-1"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "CLOUDFRONT_PRIVATE_KEY_BASE64",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:819498957810:secret:prod/docuflow/CLOUDFRONT_PRIVATE_KEY_BASE64-UPThi6"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:819498957810:secret:prod/docuflow/DATABASE_URL-c3ldCg"
        },
        {
          "name": "GOOGLE_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:819498957810:secret:prod/docuflow/GOOGLE_CLIENT_SECRET-77FtWw"
        },
        {
          "name": "JWT_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:819498957810:secret:prod/docuflow/JWT_SECRET_KEY-GcwV9m"
        },
        {
          "name": "AOT_CONFIG_CONTENT",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:819498957810:parameter/otel/docuflow-config"
        }
      ],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/docuflow-task",
          "mode": "non-blocking",
          "awslogs-create-group": "true",
          "max-buffer-size": "25m",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "systemControls": []
    },
    {
      "name": "aws-otel-collector",
      "image": "public.ecr.aws/aws-observability/aws-otel-collector:latest",
      "essential": false,
      "portMappings": [
        { "containerPort": 4317, "protocol": "tcp" },
        { "containerPort": 4318, "protocol": "tcp" }
      ],
      "environment": [{ "name": "AWS_REGION", "value": "ap-northeast-1" }],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/docuflow-task",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "otel"
        }
      }
    }
  ],
  "taskRoleArn": "arn:aws:iam::819498957810:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::819498957810:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "enableFaultInjection": false
}
