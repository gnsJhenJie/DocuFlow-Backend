{
  "family": "docuflow-task",
  "containerDefinitions": [
    {
      "name": "docuflow-api",
      "image": "819498957810.dkr.ecr.ap-northeast-1.amazonaws.com/nycu/docuflow:latest",
      "cpu": 0,
      "portMappings": [
        {
          "name": "docuflow-api-8000-tcp",
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "CLOUDFRONT_DOMAIN",
          "value": "https://ddfedtuc7b3xl.cloudfront.net"
        },
        {
          "name": "AWS_S3_BUCKET",
          "value": "nycu-docuflow"
        },
        {
          "name": "GOOGLE_CLIENT_ID",
          "value": "837988850696-2kfh7ev8710clm6353p020i2u7gvl3j7.apps.googleusercontent.com"
        },
        {
          "name": "CLOUDFRONT_KEY_PAIR_ID",
          "value": "K2BE9MO719NMM3"
        },
        {
          "name": "FRONTEND_URL",
          "value": "https://docuflow.gnsjhenjie.ninja"
        },
        {
          "name": "OTEL_EXPORTER_OTLP_PROTOCOL",
          "value": "http/protobuf"
        },
        {
          "name": "OTEL_RESOURCE_ATTRIBUTES",
          "value": "service.name=docuflow,deployment.environment=prod,aws.region=ap-northeast-1,aws.log.group.names=/ecs/docuflow-task"
        },
        {
          "name": "OTEL_AWS_APPLICATION_SIGNALS_ENABLED",
          "value": "true"
        },
        {
          "name": "OTEL_METRICS_EXPORTER",
          "value": "none"
        },
        {
          "name": "OTEL_AWS_APPLICATION_SIGNALS_EXPORTER_ENDPOINT",
          "value": "http://127.0.0.1:4316/v1/metrics"
        },
        {
          "name": "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
          "value": "http://127.0.0.1:4316/v1/traces"
        },
        {
          "name": "OTEL_TRACES_SAMPLER",
          "value": "xray"
        },
        {
          "name": "OTEL_PROPAGATORS",
          "value": "xray"
        },
        {
          "name": "OTEL_PYTHON_DISTRO",
          "value": "aws_distro"
        },
        {
          "name": "OTEL_PYTHON_CONFIGURATOR",
          "value": "aws_configurator"
        },
        {
          "name": "PYTHONPATH",
          "value": "/otel-auto-instrumentation-python/opentelemetry/instrumentation/auto_instrumentation:/app:/otel-auto-instrumentation-python"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [
        {
          "sourceVolume": "opentelemetry-auto-instrumentation-python",
          "containerPath": "/otel-auto-instrumentation-python",
          "readOnly": false
        }
      ],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "CLOUDFRONT_PRIVATE_KEY_BASE64",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:819498957810:secret:prod/docuflow/CLOUDFRONT_PRIVATE_KEY_BASE64-UPThi6"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:819498957810:secret:prod/docuflow/DATABASE_URL-c3ldCg"
        },
        {
          "name": "GOOGLE_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:819498957810:secret:prod/docuflow/GOOGLE_CLIENT_SECRET-77FtWw"
        },
        {
          "name": "JWT_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-1:819498957810:secret:prod/docuflow/JWT_SECRET_KEY-GcwV9m"
        }
      ],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/docuflow-task",
          "mode": "non-blocking",
          "awslogs-create-group": "true",
          "max-buffer-size": "25m",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "systemControls": [],
      "dependsOn": [
        {
          "containerName": "init",
          "condition": "SUCCESS"
        }
      ]
    },
    {
      "name": "ecs-cwagent",
      "image": "public.ecr.aws/cloudwatch-agent/cloudwatch-agent:1.300055.2b1110",
      "essential": true,
      "secrets": [
        {
          "name": "CW_CONFIG_CONTENT",
          "valueFrom": "arn:aws:ssm:ap-northeast-1:819498957810:parameter/cwagent/docuflow-config"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-create-group": "true",
          "awslogs-group": "/ecs/ecs-cwagent",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "init",
      "image": "public.ecr.aws/aws-observability/adot-autoinstrumentation-python:v0.9.0",
      "essential": false,
      "command": [
        "cp",
        "-a",
        "/autoinstrumentation/.",
        "/otel-auto-instrumentation-python"
      ],
      "mountPoints": [
        {
          "sourceVolume": "opentelemetry-auto-instrumentation-python",
          "containerPath": "/otel-auto-instrumentation-python",
          "readOnly": false
        }
      ]
    }
  ],
  "taskRoleArn": "arn:aws:iam::819498957810:role/ecsTaskExecutionRole",
  "executionRoleArn": "arn:aws:iam::819498957810:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [
    {
      "name": "opentelemetry-auto-instrumentation-python"
    }
  ],
  "placementConstraints": [],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "enableFaultInjection": false
}
